  "global_lexicon": {
    "core_thesis": "Nâng cao độ chính xác dự đoán biến động nitơ (NH4+-Nout, TNout) và phân tích cơ chế chuyển hóa trong xử lý nước thải độ mặn cao bằng tiếp cận học máy có thể giải thích (CatBoost kết hợp Bayesian Optimization và SHAP).",
    "key_terms": [
      {
        "term": "High-Salinity Wastewater",
        "definition": "Nước thải độ mặn cao (độ mặn 0-5%, tới hạn 35 g/L) gây ức chế vi sinh vật nitrat hóa"
      },
      {
        "term": "CatBoost",
        "definition": "Thuật toán tăng cường độ dốc tối ưu cho dữ liệu bảng, đạt R2 test = 0.88 cho NH4+-N và 0.91 cho TN"
      },
      {
        "term": "Bayesian Optimization",
        "definition": "Phương pháp tối ưu hóa siêu tham số dựa trên xác suất Gaussian Process"
      },
      {
        "term": "SHAP",
        "definition": "SHapley Additive exPlanations - Phân tích tầm quan trọng toàn cục và đóng góp cục bộ (force & waterfall plots)"
      },
      {
        "term": "AOB & NOB",
        "definition": "Ammonia-Oxidizing Bacteria và Nitrite-Oxidizing Bacteria - Vi sinh vật oxy hóa amoni và nitrit"
      },
      {
        "term": "PDP",
        "definition": "Partial Dependence Plots - Đồ thị phụ thuộc một phần xác định ngưỡng vận hành DO (3.2 mg/L)"
      }
    ],
