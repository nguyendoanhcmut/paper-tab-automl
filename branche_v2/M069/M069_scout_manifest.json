  "rule_index": [],
  "global_lexicon": {
    "core_thesis": "Nghiên cứu ứng dụng khung hồi quy logistic (LR) dựa trên dữ liệu vận hành thực tế ngoài trời 1,5 năm của hệ thống quang sinh học màng (MPBR) xử lý bậc ba sau AnMBR để dự đoán khả năng tuân thủ nồng độ amoni đầu ra (NH4-Neff < 1,6 mg N/L theo quy chuẩn tái sử dụng nước của Ý/EU) và tối ưu hóa đồng thời 4 thông số vận hành (SRT, HRT, lưu lượng sục khí Fair, tải trọng nitơ NLR) nhằm cực đại hóa lượng nước tái sử dụng và tiết kiệm 25–30% năng lượng.",
    "key_terms": [
      {
        "term": "MPBR",
        "definition": "Membrane photobioreactor - Bể phản ứng quang sinh học màng, tích hợp nuôi cấy vi tảo - vi khuẩn và màng lọc để xử lý bậc ba và thu hồi chất dinh dưỡng."
      },
      {
        "term": "AnMBR",
        "definition": "Anaerobic membrane bioreactor - Bể phản ứng sinh học màng kỵ khí xử lý chất hữu cơ sơ cấp từ nước thải đô thị."
      },
      {
        "term": "LR",
        "definition": "Logistic regression - Mô hình hồi quy logistic phân loại xác suất nhị phân vượt ngưỡng amoni."
      },
      {
        "term": "NH4-Neff",
        "definition": "Effluent ammonium nitrogen concentration - Nồng độ nitơ amoni trong dòng nước sau xử lý."
      },
      {
        "term": "preuse",
        "definition": "Probability of water reuse - Xác suất đáp ứng tiêu chuẩn tái sử dụng nước (NH4-Neff < 1,6 mg N/L theo quy chuẩn khắt khe của Ý)."
      },
      {
        "term": "SRT",
        "definition": "Solids retention time - Thời gian lưu chất rắn / sinh khối (ngày)."
      },
      {
        "term": "HRT",
        "definition": "Hydraulic retention time - Thời gian lưu thủy lực (ngày)."
      },
      {
        "term": "Fair",
        "definition": "Aeration flow rate - Lưu lượng sục khí tạo xáo trộn dòng chảy (vvm hoặc m3/h)."
      },
      {
        "term": "NLR",
        "definition": "Nitrogen loading rate - Tải trọng nạp nitơ amoni (g N/ngày)."
      },
      {
        "term": "PLR",
        "definition": "Phosphorus loading rate - Tải trọng nạp phospho (g P/ngày)."
      },
      {
        "term": "PAR / PARmax",
        "definition": "Photosynthetically active radiation - Bức xạ quang hợp hoạt dụng trung bình và cực đại (μmol m−2 s−1)."
      },
      {
        "term": "DO / DOmax",
        "definition": "Dissolved oxygen - Nồng độ oxy hòa tan trung bình và cực đại (mg/L)."
      },
      {
        "term": "OD680",
        "definition": "Optical density at 680 nm - Mật độ quang tại bước sóng 680 nm, chỉ thị gián tiếp nồng độ sinh khối vi tảo."
      },
      {
        "term": "LSA",
        "definition": "Local sensitivity analysis - Phân tích độ nhạy cục bộ dựa trên tỷ số chênh (Odds Ratio - OR)."
      },
      {
        "term": "SCADA",
        "definition": "Supervisory Control and Data Acquisition - Hệ thống điều khiển giám sát và thu thập dữ liệu công nghiệp."
      }
    ],
    "key_entities": [
      "MPBR",
      "AnMBR",
      "Hồi quy logistic (LR)",
      "NH4-Neff",
      "SRT",
      "HRT",
      "Fair",
