  "rule_index": [],
  "global_lexicon": {
    "core_thesis": "LLM-FE kết hợp tìm kiếm tiến hóa (evolutionary search) với tri thức miền (domain knowledge) và năng lực suy luận của các Mô hình Ngôn ngữ Lớn (LLMs) để tự động tạo và tối ưu hóa các chương trình biến đổi đặc trưng (feature transformation programs) cho dữ liệu dạng bảng, giải quyết bài toán tối ưu hai cấp (bilevel optimization) thông qua phản hồi thực nghiệm từ mô hình dự đoán và cơ chế quản lý bộ nhớ tiến hóa đa đảo (multi-island memory buffer).",
    "key_terms": [
      {
        "en": "Automated Feature Engineering",
        "vi": "Kỹ thuật tạo đặc trưng tự động",
        "definition": "Quy trình tự động chuyển đổi dữ liệu thô thành các đặc trưng có ý nghĩa để nâng cao hiệu năng mô hình học máy."
      },
      {
        "en": "Tabular Data",
        "vi": "Dữ liệu dạng bảng",
        "definition": "Dữ liệu có cấu trúc gồm các hàng (mẫu) và các cột (thuộc tính số học hoặc phân loại)."
      },
      {
        "en": "Evolutionary Optimization / Evolutionary Search",
        "vi": "Tối ưu hóa tiến hóa / Tìm kiếm tiến hóa",
        "definition": "Phương pháp tìm kiếm heuristic dựa trên cơ chế tiến hóa sinh học (đột biến, lai ghép, chọn lọc theo độ thích nghi) để khám phá không gian giải pháp."
      },
      {
        "en": "Feature Transformation Program",
        "vi": "Chương trình biến đổi đặc trưng",
        "definition": "Đoạn mã (Python function) do LLM sinh ra để tính toán các đặc trưng mới từ tập dữ liệu ban đầu."
      },
      {
        "en": "Bilevel Optimization",
        "vi": "Tối ưu hóa hai cấp",
        "definition": "Bài toán tối ưu hóa trong đó nghiệm của bài toán cấp trên (chương trình biến đổi) phụ thuộc vào nghiệm tối ưu của bài toán cấp dưới (huấn luyện mô hình dự đoán)."
      },
      {
        "en": "Domain Knowledge",
        "vi": "Tri thức miền / Kiến thức chuyên ngành",
        "definition": "Thông tin ngữ nghĩa và hiểu biết chuyên sâu về lĩnh vực ứng dụng của dữ liệu (y tế, tài chính, v.v.)."
      },
      {
        "en": "In-Context Demonstration",
        "vi": "Mẫu minh họa theo ngữ cảnh",
        "definition": "Các ví dụ mẫu về chương trình đặc trưng đạt điểm cao từ các vòng trước được đưa vào prompt để dẫn dắt LLM."
      },
      {
        "en": "Experience Management",
        "vi": "Quản lý kinh nghiệm / Bộ nhớ kinh nghiệm",
        "definition": "Cơ chế lưu trữ và chọn lọc các chương trình biến đổi ưu tú qua các vòng lặp vào vùng đệm bộ nhớ."
      },
      {
        "en": "Multi-Island Model / Island Model",
        "vi": "Mô hình đa đảo / Mô hình đảo",
        "definition": "Chiến lược phân chia quần thể chương trình thành nhiều đảo độc lập nhằm duy trì tính đa dạng và tránh rơi vào cực tiểu cục bộ."
      },
      {
        "en": "Boltzmann Selection Strategy",
        "vi": "Chiến lược chọn lọc Boltzmann",
        "definition": "Cơ chế chọn lọc mẫu dựa trên phân phối xác suất mềm phụ thuộc vào điểm số độ thích nghi và nhiệt độ làm nguội."
      },
      {
        "en": "Data-Driven Feedback",
        "vi": "Phản hồi dựa trên dữ liệu",
        "definition": "Điểm số đánh giá thực nghiệm (accuracy, RMSE) của mô hình dự đoán trên tập kiểm định dùng làm tín hiệu định hướng quá trình tìm kiếm."
      },
      {
        "en": "Operator-Selection Bias Mitigation",
        "vi": "Giảm thiểu thiên lệch chọn toán tử",
        "definition": "Khắc phục xu hướng thiên lệch của LLM chỉ tạo toán tử số học đơn giản (+, -, *, /) bằng cách khuyến khích các toán tử phức tạp (groupby, nonlinear)."
      },
      {
        "en": "Feature Memorization",
        "vi": "Ghi nhớ đặc trưng trong LLM",
        "definition": "Hiện tượng LLM tái hiện lại các mẫu đã học trong tập tiền huấn luyện thay vì thực sự suy luận ra đặc trưng mới."
      },
      {
        "en": "Hyperparameter Optimization (HPO)",
        "vi": "Tối ưu hóa siêu tham số",
        "definition": "Quá trình tinh chỉnh các siêu tham số của mô hình học máy (như XGBoost, MLP) bằng các công cụ như Optuna."
      },
      {
        "en": "Feature Attribution / SHAP Values",
        "vi": "Đóng góp đặc trưng / Giá trị SHAP",
        "definition": "Phương pháp lý thuyết trò chơi để định lượng mức độ đóng góp của từng đặc trưng vào kết quả dự đoán của mô hình."
      }
    ],
    "key_entities": [
      {
        "name": "LLM-FE",
        "role": "Khung làm việc đề xuất kết hợp LLM và giải thuật tiến hóa cho feature engineering."
      },
      {
        "name": "CAAFE",
        "role": "Phương pháp baseline dựa trên LLM sử dụng mô tả tác vụ để sinh ngữ cảnh đặc trưng qua prompt lặp đơn luồng."
      },
      {
        "name": "FeatLLM",
        "role": "Phương pháp baseline dùng LLM sinh các luật nhị phân hóa đặc trưng."
      },
      {
        "name": "OCTree",
        "role": "Phương pháp baseline dùng LLM kết hợp suy luận từ cây quyết định để cải tiến đặc trưng theo từng bước."
      },
      {
        "name": "OpenFE",
        "role": "Phương pháp baseline truyền thống SOTA sử dụng thuật toán boosting và tỉa đặc trưng."
      },
      {
        "name": "AutoFeat",
        "role": "Phương pháp baseline truyền thống kết hợp tìm kiếm chùm (beam search) và chọn lọc phi tuyến."
      },
      {
        "name": "XGBoost",
        "role": "Mô hình cây quyết định tăng cường gradient mặc định dùng cho đánh giá và kiểm thử."
      },
      {
        "name": "MLP",
        "role": "Mạng nơ-ron truyền thẳng nhiều lớp dùng làm mô hình dự đoán học sâu cho dữ liệu bảng."
      },
      {
        "name": "TabPFN",
        "role": "Mô hình nền tảng transformer chuyên biệt cho dữ liệu bảng không cần huấn luyện lặp lại."
      },
      {
        "name": "GPT-3.5-Turbo",
        "role": "LLM backbone mặc định được sử dụng trong các thí nghiệm chính của LLM-FE."
      },
      {
        "name": "Llama-3.1-8B-Instruct",
        "role": "LLM mã nguồn mở dùng làm backbone kiểm chứng tính tổng quát hóa."
      }
    ]
  },
