  "global_lexicon": {
    "core_thesis": "SymboLLM-FE kết hợp hồi quy ký hiệu (Symbolic Regression) với mô hình ngôn ngữ lớn (LLM) để giải quyết bài toán kỹ thuật đặc trưng tự động (AutoFE) trên dữ liệu bảng, vừa đạt độ chính xác dự báo cao và tính minh bạch diễn giải, vừa giảm số vòng lặp gọi LLM xuống hàng đơn vị nhờ không gian tìm kiếm được định hướng thống kê.",
    "key_terms": [
      {
        "term": "AutoFE (Automated Feature Engineering)",
        "definition": "Kỹ thuật đặc trưng tự động, tự động hóa quy trình sinh và lựa chọn đặc trưng tối ưu nhằm nâng cao chất lượng mô hình học máy trên dữ liệu bảng."
      },
      {
        "term": "Symbolic Regression (SR)",
        "definition": "Hồi quy ký hiệu, phương pháp tìm kiếm các biểu thức toán học tường minh tối ưu xấp xỉ biến mục tiêu bằng giải thuật lập trình di truyền."
      },
      {
        "term": "Genetic Programming (GP)",
        "definition": "Lập trình di truyền, giải thuật tiến hóa quần thể cây cú pháp (syntax trees) thông qua lai ghép, đột biến và chọn lọc tự nhiên để tìm công thức tối ưu."
      },
      {
        "term": "Tabular Data",
        "definition": "Dữ liệu dạng bảng có cấu trúc theo hàng và cột, định dạng dữ liệu phổ biến nhất trong các ứng dụng máy học thực tế."
      },
      {
        "term": "Spearman Correlation",
        "definition": "Hệ số tương quan hạng Spearman, định lượng mối quan hệ đơn điệu phi tuyến giữa đặc trưng đầu vào và biến mục tiêu một cách bền vững."
      },
      {
        "term": "Expanding-Sliding Window",
        "definition": "Cơ chế cửa sổ mở rộng - trượt trên các đặc trưng đã xếp thứ tự Spearman, giảm số lượng tập con đặc trưng từ O(2^n) xuống O(n^2)."
      },
      {
        "term": "Parsimony Penalty",
        "definition": "Hình phạt độ phức tạp cộng vào hàm mục tiêu của cây cú pháp theo nguyên lý Occam's razor, nhằm khống chế hiện tượng phình to (bloat) và chống quá khớp."
      },
      {
        "term": "LLM Refinement",
        "definition": "Cơ chế sử dụng LLM như bộ lọc ngữ nghĩa và tối ưu hóa code dựa trên các công thức ký hiệu đã được xác thực thống kê, thay vì sinh tự do."
      },
      {
        "term": "TabPFN",
        "definition": "Mô hình nền tảng dạng Transformer cho dữ liệu bảng, thực hiện học trong ngữ cảnh (in-context learning) với độ chính xác cao mà không cần tinh chỉnh siêu tham số."
      },
      {
        "term": "De-redundancy",
        "definition": "Quy trình loại bỏ đặc trưng dư thừa hoặc đa cộng tuyến thông qua phân tích tương đương toán học và phản hồi từ mô hình dự báo hạ nguồn."
      }
    ],
