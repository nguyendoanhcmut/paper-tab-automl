  "global_lexicon": {
    "core_thesis": "TOPOFE mô hình hóa kỹ thuật đặc trưng tự động (AutoFE) thành quá trình tìm kiếm chương trình tiến hóa đa đảo cấu trúc đồ thị kết hợp LLM, phân tách không gian toán tử thành các họ đặc trưng riêng biệt và học đồ thị topo động để điều phối chuyển giao tri thức khi tìm kiếm cục bộ bão hòa.",
    "key_terms": [
      {
        "term": "AutoFE (Automated Feature Engineering)",
        "definition": "Tự động hóa kỹ thuật đặc trưng nhằm tìm kiếm các biến đổi toán học/logic tối ưu từ dữ liệu thô để nâng cao hiệu năng mô hình học máy dạng bảng."
      },
      {
        "term": "Multi-island Evolution",
        "definition": "Mô hình tiến hóa đa đảo, phân chia quần thể tìm kiếm thành nhiều đảo chuyên biệt hóa theo từng họ biến đổi ngữ nghĩa để tránh hiện tượng hội tụ sớm vào một họ toán tử thống trị."
      },
      {
        "term": "Transformation Family",
        "definition": "Họ biến đổi đặc trưng Pi gồm các toán tử cùng chia sẻ một thiên kiến quy nạp (số học, thống kê, thời gian, mã hóa quan hệ, hàm phi tuyến đơn biến)."
      },
      {
        "term": "Prompt Adaptation Memory (PAM)",
        "definition": "Bộ nhớ thích ứng prompt duy trì lịch sử chấp nhận/từ chối trên từng đảo để tổng hợp tín hiệu ưu tiên/tránh né dạng ngôn ngữ tự nhiên, định hướng đề xuất LLM mà không cần cập nhật trọng số."
      },
      {
        "term": "Topology Graph",
        "definition": "Đồ thị có hướng có trọng số G biểu diễn mức độ hữu dụng chuyển giao thực nghiệm giữa các đảo, được cập nhật trực tuyến qua quy tắc làm mịn hàm mũ."
      },
      {
        "term": "Saturation Detection",
        "definition": "Tiêu chí phát hiện bão hòa dựa trên cửa sổ trượt marginal improvement để kích hoạt chuyển giao liên đảo chỉ khi tìm kiếm nội đảo đã cạn kiệt tiềm năng."
      },
      {
        "term": "Hybrid Synthesis",
        "definition": "Phép tổng hợp lai liên họ do LLM dẫn dắt, kết hợp cấu trúc từ đảo nguồn và đảo đích để tạo ra các chương trình đặc trưng thành phần mới nằm ngoài tầm với của tìm kiếm cục bộ."
      },
      {
        "term": "MPOC (Mean Pairwise Output Correlation)",
        "definition": "Hệ số tương quan đầu ra từng cặp trung bình đo lường mức độ dư thừa thông tin giữa các vector đặc trưng được tạo ra (càng thấp càng tốt)."
      },
      {
        "term": "Effective Rank (EffRank)",
        "definition": "Hạng hiệu dụng đo lường độ bao phủ chiều không gian độc lập của ma trận đặc trưng thông qua phổ giá trị kỳ dị (càng cao càng tốt)."
      },
      {
        "term": "TGSS (Topology Graph Specialization Score)",
        "definition": "Điểm chuyên biệt hóa đồ thị topo đo lường phương sai phân kỳ của trọng số chuyển giao so với khởi tạo đồng nhất, thể hiện mức độ học tri thức chuyển giao thích ứng theo tác vụ."
      }
    ],
