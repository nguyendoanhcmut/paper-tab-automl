  "global_lexicon": {
    "core_thesis": "Lựa chọn đặc trưng dựa trên tri thức chuyên gia (KBFS) và mô hình ngôn ngữ lớn (LLM-RAG) nâng cao độ chính xác mô hình học sâu (CNN-LSTM, Attention-LSTM) trong dự đoán phát thải khí N2O từ hệ thống xử lý sinh học BNR.",
    "key_terms": [
      {
        "term": "Biological Nutrient Removal",
        "definition": "BNR - Quy trình khử dinh dưỡng sinh học (quy trình 5-bước Modified Bardenpho)"
      },
      {
        "term": "N2O Emissions",
        "definition": "Khí phát thải nhà kính Nitrous Oxide sinh ra từ các quá trình nitrat hóa và khử nitrat"
      },
      {
        "term": "KBFS",
        "definition": "Knowledge-Based Feature Selection - Khung sàng lọc đặc trưng 5 bước dựa trên cơ chế sinh hóa và tương quan thời gian"
      },
      {
        "term": "LLM-RAG Feature Selection",
        "definition": "Sàng lọc đặc trưng tự động bằng mô hình ngôn ngữ lớn kết hợp truy xuất tri thức tăng cường"
      },
      {
        "term": "Attention-LSTM",
        "definition": "Kiến trúc học sâu kết hợp mạng nơ-ron bộ nhớ dài-ngắn hạn với cơ chế chú ý"
      }
    ],
    "key_entities": [
      "BNR",
      "N2O",
      "KBFS",
      "LLM-RAG",
      "Attention-LSTM"
    ]
  },
