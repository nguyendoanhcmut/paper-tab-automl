  "global_lexicon": {
    "core_thesis": "Tối đa hóa hiệu quả khử nitơ (TN) trong trạm xử lý MBR quy mô thực thông qua tích hợp bể chuyển đổi (swing-basin) và bể giảm oxy hòa tan (DO-R), ứng dụng học máy giải thích được và tối ưu hóa lấy cảm hứng sinh học (Differential Evolution).",
    "key_terms": [
      {
        "term": "Swing-Basin",
        "definition": "Bể phản ứng chuyển đổi linh hoạt chế độ thiếu khí (anoxic) và hiếu khí (aerobic) theo tải lượng đầu vào"
      },
      {
        "term": "DO Reduction Basin",
        "definition": "DO-R - Bể giảm nồng độ oxy hòa tan trong dòng bùn tuần hoàn nhằm tránh ức chế quá trình khử nitrat"
      },
      {
        "term": "Bio-Inspired Machine Learning",
        "definition": "Tiếp cận tối ưu hóa siêu tham số và vận hành kết hợp mô hình học máy (RF, CatBoost, XGBoost) với thuật toán tiến hóa vi phân (DE)"
      },
      {
        "term": "SHAP & PDP Analysis",
        "definition": "Phương pháp giải thích tương tác phi tuyến giữa DO, nồng độ bùn hoạt tính (MLSS) và tỷ lệ C/N"
      }
    ],
    "key_entities": [
      "MBR",
      "Swing-Basin",
      "DO-R",
      "Differential Evolution",
      "Nitrogen Removal"
    ]
  },
