  "global_lexicon": {
    "core_thesis": "An explainable cross-plant transfer learning framework predicts transmembrane pressure in data-limited pilot-scale membrane bioreactors by leveraging LSTM models pretrained on data-rich source plants to capture shared extracellular polymeric substance patterns and adaptively recalibrating plant-specific fouling mechanisms using modest target-plant fine-tuning data.",
    "key_terms": [
      {
        "term": "MBR (Membrane Bioreactor)",
        "definition": "An advanced wastewater treatment process combining biological activated sludge treatment with microfiltration or ultrafiltration membrane separation."
      },
      {
        "term": "TMP (Transmembrane Pressure)",
        "definition": "The pressure difference across the membrane filtration barrier, serving as the primary operational indicator of membrane fouling development under constant flux."
      },
      {
        "term": "EPS (Extracellular Polymeric Substances)",
        "definition": "Biomacromolecular slime (proteins and carbohydrates) secreted by microorganisms or released by cell lysis, acting as primary foulants forming cake layers on membrane surfaces."
      },
      {
        "term": "EPSc (EPS Carbohydrates / Polysaccharides)",
        "definition": "Carbohydrate fraction of EPS that serves as a highly conserved, transferable fouling signal across different MBR treatment plants."
      },
      {
        "term": "EPSp (EPS Proteins)",
        "definition": "Proteinaceous fraction of EPS whose fouling contribution is selectively amplified and recalibrated under iron-enriched influent conditions in the target plant."
      },
      {
        "term": "SMP (Soluble Microbial Products)",
        "definition": "Soluble microbial excretion and decay products that pass through microfilters or accumulate in mixed liquor, driving internal pore blocking."
      },
      {
        "term": "SMPp (SMP Proteins)",
        "definition": "Protein fraction of soluble microbial products that plays an elevated fouling role during microbial stress or shock events in industrial wastewater treatment."
      },
      {
        "term": "Transfer Learning",
        "definition": "A machine learning paradigm that transfers knowledge representations from data-rich source systems to improve predictive generalization in data-scarce target systems."
      },
      {
        "term": "Fine-Tuning (FT)",
        "definition": "Adaptive recalibration of pretrained model weights using limited target-plant data (such as a 40% target fine-tuning ratio)."
      },
      {
        "term": "LSTM (Long Short-Term Memory)",
        "definition": "A recurrent neural network architecture designed to capture sequential temporal dependencies and long-term trends in dynamic membrane fouling processes."
      },
      {
        "term": "XGBoost (Extreme Gradient Boosting)",
        "definition": "A gradient boosted decision tree ensemble algorithm utilized as a competitive baseline and base predictive model."
      },
      {
        "term": "SHAP (SHapley Additive exPlanations)",
        "definition": "A game-theoretic interpretability method that assigns each input feature an additive attribution score explaining individual and global model predictions."
      },
      {
        "term": "LOFO (Leave-One-Feature-Out)",
        "definition": "A model-agnostic feature importance technique that systematically removes one input variable at a time to quantify its impact on predictive accuracy."
      },
      {
        "term": "PCA (Principal Component Analysis)",
        "definition": "An unsupervised orthogonal transformation used to visualize distributional overlap, cluster boundaries, and domain shifts between source and target MBR datasets."
      },
      {
        "term": "CIP (Clean-in-Place)",
        "definition": "An in-situ chemical cleaning sequence (citric acid followed by sodium hypochlorite) used to restore membrane flux and quantify inorganic vs. organic foulant mass."
      }
    ],
    "key_entities": [
      "Long Short-Term Memory (LSTM)",
      "Extreme Gradient Boosting (XGBoost)",
      "SHapley Additive exPlanations (SHAP)",
      "Leave-One-Feature-Out (LOFO)",
      "Transmembrane Pressure (TMP)",
      "Extracellular Polymeric Substances (EPS)",
      "Soluble Microbial Products (SMP)",
      "Target Pilot-Scale MBR Plant (Singapore)",
      "Source Plants 1–3 (Singapore)",
      "Industrial Wastewater MBR Plant"
    ]
  },
