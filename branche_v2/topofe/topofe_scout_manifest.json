  "global_lexicon": {
    "core_thesis": "TOPOFE mô hình hóa kỹ nghệ đặc trưng tự động (AutoFE) cho dữ liệu dạng bảng dưới dạng tìm kiếm chương trình tiến hóa đa đảo có cấu trúc đồ thị (graph-structured multi-island evolution), kết hợp bộ nhớ thích ứng prompt (PAM) và chuyển giao tri thức liên đảo dựa trên độ bão hòa (saturation-triggered transfer) được điều phối bởi đồ thị tô-pô học động, giúp khám phá các đặc trưng đa họ có độ dư thừa thấp và độ bao phủ biểu diễn cao.",
    "key_terms": [
      {
        "term": "AutoFE",
        "definition": "Kỹ nghệ đặc trưng tự động (Automated Feature Engineering) cho dữ liệu bảng nhằm tối ưu hóa hiệu năng mô hình học máy."
      },
      {
        "term": "Multi-island Decomposition",
        "definition": "Phân rã không gian chương trình đặc trưng thành các phân quần thể (đảo) độc lập theo họ biến đổi ngữ nghĩa."
      },
      {
        "term": "Transformation Family",
        "definition": "Họ biến đổi ngữ nghĩa đồng nhất chia sẻ cùng tiên nghiệm quy nạp (số học, thống kê, thời gian, quan hệ, phi tuyến)."
      },
      {
        "term": "Prompt Adaptation Memory (PAM)",
        "definition": "Bộ nhớ duy trì lịch sử chấp nhận/bác bỏ của từng đảo để thích ứng prompt LLM bằng tín hiệu tự nhiên prefer/avoid mà không cập nhật tham số."
      },
      {
        "term": "Topology Graph",
        "definition": "Đồ thị có hướng có trọng số học trực tuyến biểu diễn độ hữu dụng chuyển giao tri thức thực nghiệm giữa các đảo họ biến đổi."
      },
      {
        "term": "Saturation Detection",
        "definition": "Cơ chế phát hiện bão hòa dựa trên cửa sổ trượt để kích hoạt chuyển giao liên đảo khi tìm kiếm cục bộ cạn kiệt tiềm năng cải thiện."
      },
      {
        "term": "Hybrid Synthesis",
        "definition": "Tổng hợp lai liên đảo qua LLM để sinh chương trình kết hợp cấu trúc từ đảo nguồn và đích, vượt qua giới hạn của tìm kiếm đơn họ."
      },
      {
        "term": "MPOC",
        "definition": "Mean Pairwise Output Correlation - độ đo độ dư thừa cục bộ giữa các cặp đặc trưng được chấp nhận."
      },
      {
        "term": "EffRank",
        "definition": "Effective Rank - độ đo độ bao phủ chiều không gian biểu diễn dựa trên phổ giá trị kỳ dị."
      },
      {
        "term": "TGSS",
        "definition": "Topology Graph Specialization Score - điểm chuyên biệt hóa cấu trúc đồ thị tô-pô đo lường sự thích ứng đặc thù theo bài toán."
      }
    ],
    "key_entities": [
