  "global_lexicon": {
    "core_thesis": "Phân loại chất lượng nước mặt quy mô quốc gia bằng khung làm việc AutoML giải thích được (Auto-sklearn kết hợp SHAP) nhằm sàng lọc bộ chỉ số giám sát then chốt chi phí thấp (CODMn, TP, NH4-N).",
    "key_terms": [
      {
        "term": "Auto-sklearn",
        "definition": "Khung làm việc Automated Machine Learning tự động hóa lựa chọn thuật toán và tối ưu siêu tham số Bayesian"
      },
      {
        "term": "Surface Water Quality Classification",
        "definition": "Phân loại chất lượng nước mặt theo 5 cấp tiêu chuẩn môi trường quốc gia (GB3838-2002)"
      },
      {
        "term": "SHAP Indicator Screening",
        "definition": "Sàng lọc chỉ tiêu chất lượng nước then chốt dựa trên đóng góp giá trị Shapley toàn cục"
      },
      {
        "term": "Regional Heterogeneity",
        "definition": "Tính không đồng nhất theo không gian và lưu vực của các chỉ số ô nhiễm chính"
      }
    ],
    "key_entities": [
      "AutoML",
