  "global_lexicon": {
    "core_thesis": "Nhận dạng trạng thái bùn hạt hiếu khí (AGS) theo chu kỳ sống trong bể phản ứng sinh học màng dòng chảy liên tục (AGS-MBR) bằng thị giác máy tính và học sâu (YOLOv8 kết hợp t-SNE và SHAP).",
    "key_terms": [
      {
        "term": "Aerobic Granular Sludge",
        "definition": "AGS - Bùn hạt hiếu khí với 4 giai đoạn vòng đời: khởi tạo (Initial), phát triển (Growth), trưởng thành (Maturity), phân hủy (Disintegration)"
      },
      {
        "term": "AGS-MBR System",
        "definition": "Hệ thống tích hợp bùn hạt hiếu khí và màng lọc sợi rỗng trong dòng chảy liên tục"
      },
      {
        "term": "YOLOv8",
        "definition": "You Only Look Once phiên bản 8 - Mô hình thị giác máy tính nhận dạng và phân loại trạng thái bùn thời gian thực (mAP50 = 93.4%)"
      },
      {
        "term": "t-SNE Cluster Analysis",
        "definition": "t-Distributed Stochastic Neighbor Embedding - Giảm chiều và trực quan hóa phân cụm các pha sinh trưởng của bùn"
      },
      {
        "term": "SHAP Interpretability",
        "definition": "Giải thích đóng góp của các đặc trưng hình thái (kích thước hạt, độ tròn, tỷ lệ khung hình) đối với quyết định phân loại"
      }
    ],
    "key_entities": [
      "AGS",
      "MBR",
      "YOLOv8",
      "t-SNE",
      "SHAP",
      "Life-Cycle"
    ]
  },
