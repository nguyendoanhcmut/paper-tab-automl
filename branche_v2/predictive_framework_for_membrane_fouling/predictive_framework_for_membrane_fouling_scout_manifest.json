  "global_lexicon": {
    "core_thesis": "This study develops a predictive and interpretable machine learning framework for membrane fouling in full-scale membrane bioreactors (MBRs) treating food processing wastewater by integrating AI-driven feature engineering (robust scaling and moving average) with explainable AI (feature importance and SHAP), demonstrating that CatBoost achieves the highest predictive accuracy (R2 = 0.8374) with food-to-microorganism (F/M) ratio and MLSS identified as the most critical fouling drivers.",
    "key_terms": [
      {
        "term": "Membrane Bioreactor (MBR)",
        "definition": "Wastewater treatment system combining biological degradation with membrane filtration."
      },
      {
        "term": "Membrane Fouling",
        "definition": "Accumulation of particles, colloids, macromolecules, and microorganisms on the membrane surface or within pores, deteriorating permeability and increasing filtration resistance."
      },
      {
        "term": "Transmembrane Pressure (TMP)",
        "definition": "Pressure gradient driving permeation across the membrane (kPa); a key operational indicator of fouling resistance."
      },
      {
        "term": "Specific Flux (Spec. Flux)",
        "definition": "Membrane permeability defined as filtration flux divided by transmembrane pressure (Flux/TMP, LMH/kPa)."
      },
      {
        "term": "Food-to-Microorganism Ratio (F/M)",
        "definition": "Ratio of organic substrate loading (COD) to biomass quantity (MLSS), determining microbial growth kinetics and fouling potential."
      },
      {
        "term": "Mixed Liquor Suspended Solids (MLSS)",
        "definition": "Total suspended solids concentration in the bioreactor mixed liquor (mg/L), representing biomass density."
      },
      {
        "term": "Sludge Volume Index (SVI)",
        "definition": "Physical indicator of activated sludge settling characteristics (mL/g)."
      },
      {
        "term": "Chemical Oxygen Demand Removal (COD RM)",
        "definition": "Percentage efficiency of organic contaminant removal across the bioreactor system."
      },
      {
        "term": "Robust Scaling",
        "definition": "Data normalization method centering on the median and scaling by the interquartile range (IQR), robust to non-normal distributions and operational outliers."
      },
      {
        "term": "Moving Average (MA)",
        "definition": "Time-series feature engineering technique smoothing high-frequency noise and capturing cumulative fouling progression over operational window sizes."
      },
      {
        "term": "CatBoost",
        "definition": "Gradient boosted decision tree algorithm specialized in handling numerical and categorical features with ordered boosting, achieving superior accuracy on tabular MBR operational data."
      },
      {
        "term": "SHAP (Shapley Additive exPlanations)",
        "definition": "Game-theoretic explainability technique quantifying the marginal contribution of each operational parameter to individual and global model predictions."
      },
      {
        "term": "Permutation Importance",
        "definition": "Model-agnostic feature importance technique measuring prediction error increase after randomly shuffling feature values."
      }
    ],
    "key_entities": [
      "Full-scale food wastewater treatment plant (Beijing, China)",
      "Membrane bioreactor (MBR) system",
      "CatBoost",
      "XGBoost",
      "LightGBM",
      "Gradient Boosting Machine (GBM)",
      "Random Forest (RF)",
      "Support Vector Regression (SVR)",
      "Multiple Linear Regression (MLR)",
      "Ridge Regression",
      "Lasso Regression",
      "SHAP (Shapley Additive Explanations)",
      "RobustScaler",
      "Moving Average Filter"
    ]
  },
