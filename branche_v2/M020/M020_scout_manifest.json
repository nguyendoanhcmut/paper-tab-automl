  "global_lexicon": {
    "core_thesis": "Phát triển và so sánh các mô hình mạng nơ-ron nhân tạo (MLP và LSTM) kết hợp tối ưu hóa siêu tham số bằng Optuna và phân tích khả năng giải thích bằng SHAP để dự đoán chính xác hiện tượng tắc nghẽn màng (thông qua TMP) trong hệ thống bể phản ứng sinh học màng kỵ khí (AnMBR) quy mô pilot lớn (5000 L) xử lý nước thải đô thị thực tế trong suốt 525 ngày vận hành.",
    "key_terms": [
      {
        "term": "AnMBR",
        "definition": "Anaerobic membrane bioreactor - Bể phản ứng sinh học màng kỵ khí"
      },
      {
        "term": "TMP",
        "definition": "Transmembrane pressure - Áp suất qua màng (chỉ số chính đánh giá mức độ tắc nghẽn màng)"
      },
      {
        "term": "MLP",
        "definition": "Multilayer perceptron - Mạng nơ-ron truyền thẳng nhiều tầng"
      },
      {
        "term": "LSTM",
        "definition": "Long short-term memory - Mạng nơ-ron hồi quy có bộ nhớ dài-ngắn hạn"
      },
      {
        "term": "HPO",
        "definition": "Hyperparameter optimization - Tối ưu hóa siêu tham số (sử dụng framework Optuna)"
      },
      {
        "term": "SHAP",
        "definition": "SHapley Additive exPlanations - Phương pháp giải thích mô hình máy học dựa trên lý thuyết trò chơi"
      },
      {
        "term": "EPS",
        "definition": "Extracellular polymeric substances - Các chất polyme ngoại bào (gồm protein EPSp và polysaccharide EPSc)"
      },
      {
        "term": "OLR",
        "definition": "Organic loading rate - Tải lượng hữu cơ (g COD/L/d)"
      },
      {
        "term": "Flux",
        "definition": "Thông lượng màng (LMH - L/m²/h)"
      },
      {
        "term": "MLSS",
        "definition": "Mixed liquor suspended solids - Nồng độ chất rắn lơ lửng trong hỗn hợp bùn"
      }
    ],
    "key_entities": [
      "AnMBR",
