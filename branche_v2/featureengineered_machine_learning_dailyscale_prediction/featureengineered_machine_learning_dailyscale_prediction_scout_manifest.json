  "global_lexicon": {
    "core_thesis": "Học máy kỹ nghệ đặc trưng dự đoán tổng photpho (T-P) đầu ra quy mô ngày và tối ưu hóa liều lượng châm phèn ferric sulfate Fe2(SO4)3 trong hệ thống tuyển nổi khí hòa tan DAF quy mô thực.",
    "key_terms": [
      {
        "term": "DAF System",
        "definition": "Dissolved Air Flotation - Hệ thống tuyển nổi khí hòa tan xử lý bậc ba cho trạm xử lý nước thải (WWTP)"
      },
      {
        "term": "Effluent T-P Prediction",
        "definition": "Dự đoán nồng độ photpho tổng đầu ra theo thang thời gian ngày"
      },
      {
        "term": "Ferric Sulfate Coagulant",
        "definition": "Chất keo tụ muối sắt Fe2(SO4)3 tối ưu hóa liều lượng châm dựa trên phân tích độ nhạy SHAP"
      },
      {
        "term": "MICE Imputation",
        "definition": "Multivariate Imputation by Chained Equations - Thuật toán điền khuyết đa biến cho chuỗi thời gian"
      },
      {
        "term": "Random Forest",
        "definition": "Mô hình học máy ngẫu nhiên đạt hiệu năng dự đoán tối ưu (R2 = 0.776, RMSE = 0.016 mg/L)"
      }
    ],
    "key_entities": [
      "DAF",
      "Total Phosphorus",
      "Random Forest",
      "Coagulant Dosing",
      "SHAP"
    ]
  },
