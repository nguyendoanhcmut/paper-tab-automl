      },
      {
        "term": "UASB",
        "definition": "Upflow anaerobic sludge blanket - Bể bùn kỵ khí dòng chảy ngược"
      },
      {
        "term": "SMP",
        "definition": "Soluble microbial products - Sản phẩm vi sinh vật hòa tan"
