  "global_lexicon": {
    "core_thesis": "An interpretable machine-learning framework combining Extra Trees benchmarking, multi-model SHAP interpretability, and manifold-constrained feasibility sampling establishes an actionable, multi-objective operational basin for a full-scale semiconductor wastewater membrane bioreactor, identifying sludge retention time (SRT) as the dominant fouling driver and raising simultaneous target attainment from 37% to over 61–82%.",
    "key_terms": [
      {
        "term": "MBR",
        "definition": "Membrane bioreactor, an integrated biological treatment and membrane filtration (submerged PVDF hollow-fibre) process for wastewater purification."
      },
      {
        "term": "TMP",
        "definition": "Transmembrane pressure, the pressure gradient driving water permeation across the membrane and principal indicator of membrane fouling."
      },
      {
        "term": "Permeate Flow",
        "definition": "Treated effluent flow rate drawn through the membrane module by suction pump, with target >= 1.5 m3/min."
      },
      {
        "term": "Water Level",
        "definition": "Liquid level in the membrane tank serving as an integrative hydraulic state variable reflecting hydraulic balance and solids accumulation."
      },
      {
        "term": "SRT",
        "definition": "Sludge retention time (mean solids residence time in the bioreactor), identified as the dominant driver of TMP and fouling across the 43.3–108.3 day extended-aeration regime."
      },
      {
        "term": "HRT",
        "definition": "Hydraulic retention time (liquid residence time in the biological reactor), acting as a sharp hydraulic lever controlling throughput and membrane loading."
      },
      {
        "term": "MLSS",
        "definition": "Mixed liquor suspended solids concentration in the bioreactor, exhibiting non-monotonic scaling with cake resistance."
      },
      {
        "term": "F/M",
        "definition": "Food-to-microorganism ratio, representing organic substrate loading rate per unit of active microbial biomass."
      },
      {
        "term": "SHAP",
        "definition": "SHapley Additive exPlanations, a cooperative game-theoretic framework evaluating feature importance and non-linear interactions across models."
      },
      {
        "term": "Extra Trees",
        "definition": "Extremely Randomized Trees ensemble regressor, achieving highest accuracy and robustness across random, blocked, chronological, and parallel-train validations."
      },
      {
        "term": "Manifold-Constrained Resampling",
        "definition": "Feasibility sampling method perturbing states along local covariance within the plant's reachable space (500,000 samples) rather than independent marginal ranges."
      },
      {
        "term": "Attainment Rate",
        "definition": "Proportion of operating hours simultaneously satisfying TMP <= 0.15 bar, permeate flow >= 1.5 m3/min, and membrane tank level 58–60%."
      }
    ],
    "key_entities": [
      "SUEZ PVDF hollow-fibre ultrafiltration membranes",
      "Asan City semiconductor wastewater treatment plant",
      "Extra Trees Regressor",
      "TreeSHAP / KernelSHAP",
      "SCADA dataset (4593 hourly records)",
      "Parallel B stream validation dataset"
    ]
  },
