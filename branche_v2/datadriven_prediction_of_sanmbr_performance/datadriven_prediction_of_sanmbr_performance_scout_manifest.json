  "global_lexicon": {
    "core_thesis": "Dự đoán hiệu suất xử lý COD và đánh giá nguy cơ tắc nghẽn màng của hệ thống SAnMBR dưới tải sốc phenolic (2,4-DCP) bằng các mô hình học máy đối sánh (MLR, SVR, ANN).",
    "key_terms": [
      {
        "term": "SAnMBR",
        "definition": "Submerged Anaerobic Membrane Bioreactor - Bể phản ứng sinh học màng kỵ khí ngập nước"
      },
      {
        "term": "Phenolic Shock Loads",
        "definition": "Tải trọng sốc hợp chất phenolic (2,4-dichlorophenol, 2,4-DCP) gây ức chế vi sinh vật kỵ khí"
      },
      {
        "term": "Support Vector Regression",
        "definition": "SVR - Thuật toán hồi quy vector hỗ trợ đạt độ chính xác cao nhất (R2 > 0.95)"
      },
      {
        "term": "PDP",
        "definition": "Partial Dependence Plots - Đồ thị phụ thuộc một phần phân tích tác động phi tuyến của các biến vận hành"
      }
    ],
    "key_entities": [
      "SAnMBR",
      "Phenolic Shock",
      "2,4-DCP",
      "SVR",
      "COD Removal"
    ]
  },
