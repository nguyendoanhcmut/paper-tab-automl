  "global_lexicon": {
    "core_thesis": "Machine learning methods (ANN, SVM, RF, and LSTM) provide superior predictive accuracy and generalization over traditional empirical and mechanistic models for membrane bioreactor (MBR) pollutant removal and membrane fouling, with future implementation hinging on hyperparameter optimization, AutoML, and explainable artificial intelligence (XAI).",
    "key_terms": [
      {
        "term": "MBR (Membrane Bioreactor)",
        "definition": "An advanced wastewater treatment and reclamation technology combining biological treatment (activated sludge) with low-pressure membrane filtration."
      },
      {
        "term": "Membrane Fouling",
        "definition": "The accumulation of foulants (organic compounds, inorganic salts, colloids, and microorganisms) on the membrane surface or within pores, leading to declining permeate flux and increasing transmembrane pressure."
      },
      {
        "term": "TMP (Transmembrane Pressure)",
        "definition": "The pressure difference across the membrane that drives filtration, commonly monitored as the principal indicator of fouling progression."
      },
      {
        "term": "SVM / SVR (Support Vector Machine / Support Vector Regression)",
        "definition": "Supervised learning algorithms based on statistical learning theory that use kernel functions to map nonlinear inputs to high-dimensional spaces and maximize margin boundaries."
      },
      {
        "term": "ANN (Artificial Neural Network)",
        "definition": "Information-processing models inspired by biological neural networks, comprising input, hidden, and output layers with interconnected neurons that learn complex nonlinear mappings."
      },
      {
        "term": "BPNN (Back Propagation Neural Network)",
        "definition": "A multilayer feedforward neural network trained via error backpropagation using gradient descent optimization to update synaptic weights."
      },
      {
        "term": "RF (Random Forest)",
        "definition": "An ensemble learning algorithm constructed from multiple decision trees using bootstrap aggregating (bagging) and random feature selection to mitigate overfitting."
      },
      {
        "term": "LSTM (Long Short-Term Memory)",
        "definition": "A recurrent neural network (RNN) architecture equipped with input, forget, and output gates that capture long-term temporal dependencies in dynamic time-series MBR data."
      },
      {
        "term": "GA (Genetic Algorithm)",
        "definition": "A bio-inspired heuristic search and global optimization algorithm based on natural selection and genetics (crossover, mutation, selection) frequently used for ML hyperparameter tuning."
      },
      {
        "term": "AutoML (Automated Machine Learning)",
        "definition": "Systems that automate the end-to-end pipeline of machine learning, including data preprocessing, feature engineering, model selection, and hyperparameter optimization."
      },
      {
        "term": "XAI (Explainable Artificial Intelligence)",
        "definition": "Interpretable AI techniques (e.g., SHAP, Garson algorithm, connection weights) that reveal feature contributions and uncover physical mechanisms within black-box models."
      },
      {
        "term": "RMSE (Root Mean Square Error)",
        "definition": "An assessment metric measuring the square root of the mean squared differences between observed values and model predictions."
      },
      {
        "term": "MAE (Mean Absolute Error)",
        "definition": "An evaluation metric representing the average absolute difference between predicted and actual observed values."
      },
      {
        "term": "R² (Coefficient of Determination)",
        "definition": "A statistical measure of goodness-of-fit indicating the proportion of variance in the dependent variable explained by independent features."
      },
      {
        "term": "EPS (Extracellular Polymeric Substances)",
        "definition": "High-molecular biopolymers secreted by microbial cells that constitute major foulants forming cake layers on membrane surfaces."
      }
    ],
    "key_entities": [
      "Membrane Bioreactor (MBR)",
      "Support Vector Machine (SVM)",
      "Artificial Neural Network (ANN)",
      "Back Propagation Neural Network (BPNN)",
      "Random Forest (RF)",
